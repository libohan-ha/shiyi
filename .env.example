# Docker Compose configuration. Copy to .env in the project root.
SHIYI_HTTP_PORT=8765
SHIYI_BIND_HOST=127.0.0.1
SHIYI_PUBLIC_URL=http://127.0.0.1:8765
SHIYI_TRUSTED_HOSTS=localhost,127.0.0.1
SHIYI_SECURE_COOKIES=false
SHIYI_ALLOW_REGISTRATION=false

# For HTTPS, set your real domain, public URL and trusted hosts; use secure cookies.
# Start with: docker compose --profile https up -d --build
SHIYI_DOMAIN=study.example.com
