# Local development defaults. Copy to backend/.env only if customization is needed.
SHIYI_DATABASE_URL=sqlite:///./data/shiyi.db
SHIYI_DATA_DIR=./data
SHIYI_PUBLIC_URL=http://127.0.0.1:8765
SHIYI_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Additional exact browser origins, separated by commas. start-lan.cmd configures these automatically.
SHIYI_ALLOWED_ORIGINS=
SHIYI_SECURE_COOKIES=false
SHIYI_ALLOW_REGISTRATION=false
